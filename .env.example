# AGORA_AI_APP_ID: Agora RTC App ID for Agora AI Voice Assistant Engine
AGORA_AI_APP_ID="MY_AGORA_AI_APP_ID"

# AGORA_AI_API_KEY: API Key / Token for Agora Conversational AI Voice Assistant
AGORA_AI_API_KEY="MY_AGORA_AI_API_KEY"

# AGORA_AI_AGENT_ID: Dedicated Agora AI Voice Agent ID
AGORA_AI_AGENT_ID="sre-zero-voice-agent"

# AGORA_AI_CUSTOMER_ID: Agora Customer ID for Real-Time Voice Bridge
AGORA_AI_CUSTOMER_ID="MY_AGORA_CUSTOMER_ID"

# AGORA_AI_CUSTOMER_SECRET: Agora Customer Secret for RTC Voice Channel
AGORA_AI_CUSTOMER_SECRET="MY_AGORA_CUSTOMER_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
